{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fukumakase",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory":"dist/client","binding":"ASSETS","not_found_handling":"none","run_worker_first":["/api","/api/*","/health"]},
  "triggers": {"crons":["*/10 * * * *"]},
  "r2_buckets": [{"binding":"CLOTHES_BUCKET","bucket_name":"fukumakase-private-clothes"}],
  "vars": {"UPLOADS_ENABLED":"true","WEATHER_FORECAST_DAYS":"3"},
  "observability": {"enabled":false}
}
